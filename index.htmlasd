<!DOCTYPE html>
<html lang="es-MX">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Antonio González — Técnico de línea blanca</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Archivo+Expanded:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FFFFFF;
    --panel: #FFFFFF;
    --ink: #0D111A;
    --ink-soft: #565F6E;
    --steel: #1D3E8C;
    --steel-deep: #0A1B45;
    --signal: #D6293B;
    --signal-deep: #A81F2C;
    --line: #E1E4EB;
    --ok: #1D3E8C;
    --radius-panel: 22px;
    --radius-dial: 999px;
    --font-display: "Archivo Expanded", "Archivo", sans-serif;
    --font-head: "Archivo", sans-serif;
    --font-body: "Inter", sans-serif;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }
  body{
    margin:0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  img{ max-width:100%; display:block; }
  a{ color:inherit; }

  .wrap{ max-width: 1120px; margin:0 auto; padding: 0 28px; }
  @media (max-width: 560px){ .wrap{ padding: 0 20px; } }

  /* ---------- header ---------- */
  header{
    position: sticky; top:0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding: 16px 0;
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    font-family: var(--font-head); font-weight:700; font-size: 1.02rem;
    letter-spacing: -0.01em;
  }
  .brand-mark{
    width: 34px; height:34px; border-radius: 9px;
    background: var(--steel-deep);
    position: relative; flex-shrink:0;
  }
  .brand-mark::after{
    content:""; position:absolute; inset:8px;
    border: 2px solid var(--bg); border-radius: 50%;
  }
  .call-chip{
    display:flex; align-items:center; gap:9px;
    background: var(--signal); color:#fff;
    padding: 9px 16px; border-radius: var(--radius-dial);
    font-weight:600; font-size:.92rem; text-decoration:none;
    white-space: nowrap;
    box-shadow: 0 6px 16px -6px color-mix(in srgb, var(--signal) 70%, transparent);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .call-chip:hover{ transform: translateY(-1px); box-shadow: 0 10px 20px -6px color-mix(in srgb, var(--signal) 65%, transparent); }
  .call-chip svg{ width:15px; height:15px; flex-shrink:0; }

  /* ---------- hero ---------- */
  .hero{
    padding: 68px 0 56px;
    display:grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items:center;
  }
  @media (max-width: 860px){ .hero{ grid-template-columns: 1fr; padding: 40px 0 40px; gap:36px; } }

  .eyebrow-row{
    display:flex; align-items:center; gap:10px; margin-bottom: 22px;
  }
  .led{
    width:9px; height:9px; border-radius:50%; background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 22%, transparent);
    flex-shrink:0;
  }
  .eyebrow-row span{
    font-size: .86rem; color: var(--ink-soft); font-weight:500;
  }

  h1{
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.6vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: 0 0 22px;
    font-weight: 800;
    color: var(--ink);
  }
  h1 em{
    font-style: normal;
    color: var(--steel-deep);
  }
  .hero p.lead{
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 30px;
  }
  .hero-ctas{ display:flex; flex-wrap:wrap; gap:12px; margin-bottom: 30px; }
  .btn{
    display:inline-flex; align-items:center; gap:9px;
    padding: 14px 22px; border-radius: var(--radius-dial);
    font-weight:600; font-size: .98rem; text-decoration:none;
    border: 1px solid transparent; cursor:pointer;
  }
  .btn-primary{ background: var(--signal); color:#fff; }
  .btn-primary:hover{ background: var(--signal-deep); }
  .btn-ghost{ background: transparent; color: var(--ink); border-color: var(--line); }
  .btn-ghost:hover{ border-color: var(--steel); color: var(--steel-deep); }
  .btn svg{ width:16px; height:16px; }

  .hero-trust{
    display:flex; gap: 26px; flex-wrap:wrap;
  }
  .hero-trust .item{ display:flex; align-items:baseline; gap:7px; }
  .hero-trust .num{ font-family: var(--font-head); font-weight:800; font-size:1.25rem; color: var(--steel-deep); }
  .hero-trust .lbl{ font-size:.82rem; color: var(--ink-soft); }

  /* ---------- hero panel illustration ---------- */
  .panel-art{
    background: linear-gradient(155deg, var(--ink), var(--steel-deep) 65%, var(--steel));
    border-radius: 28px;
    padding: 30px;
    position: relative;
    overflow:hidden;
    aspect-ratio: 1 / 1.02;
  }
  .panel-art::before{
    content:"";
    position:absolute; inset:0;
    background: radial-gradient(circle at 78% 18%, color-mix(in srgb, #fff 14%, transparent), transparent 45%);
    pointer-events:none;
  }
  .panel-art svg{ width:100%; height:100%; position:relative; z-index:1; }

  /* ---------- section shell ---------- */
  section{ padding: 64px 0; border-top: 1px solid var(--line); }
  .section-head{ max-width: 640px; margin-bottom: 40px; }
  .section-head .kicker{
    font-size:.86rem; color: var(--steel-deep); font-weight:600; margin-bottom:10px;
    display:flex; align-items:center; gap:8px;
  }
  .section-head .kicker .dash{ width:20px; height:2px; background: var(--steel-deep); border-radius:2px; }
  .section-head h2{
    font-family: var(--font-head);
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    font-weight: 700; letter-spacing:-0.01em; margin: 0 0 12px;
  }
  .section-head p{ color: var(--ink-soft); margin:0; font-size:1.02rem; }

  /* ---------- services: control-panel grid ---------- */
  .dial-grid{
    display:grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
  }
  @media (max-width: 780px){ .dial-grid{ grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px){ .dial-grid{ grid-template-columns: 1fr; } }

  .dial{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    padding: 26px 22px;
    display:flex; flex-direction:column; gap: 16px;
    transition: border-color .18s ease, transform .18s ease;
  }
  .dial:hover{ border-color: var(--steel); transform: translateY(-2px); }
  .dial-top{ display:flex; align-items:center; justify-content:space-between; }
  .dial-knob{
    width: 46px; height:46px; border-radius:50%;
    background: var(--bg);
    border: 1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    position:relative;
  }
  .dial-knob svg{ width:22px; height:22px; stroke: var(--steel-deep); }
  .dial-knob::after{
    content:""; position:absolute; top:5px; left:50%; width:2px; height:7px;
    background: var(--signal); transform: translateX(-50%); border-radius:2px;
  }
  .dial-tag{
    font-size:.72rem; font-weight:600; color: var(--ink-soft);
    border: 1px solid var(--line); border-radius: var(--radius-dial);
    padding: 3px 9px;
  }
  .dial h3{ font-family: var(--font-head); font-size:1.08rem; margin:0; font-weight:700; }
  .dial p{ margin:0; color: var(--ink-soft); font-size: .92rem; }

  /* ---------- what we do (instalación / mantenimiento / reparación) ---------- */
  .stage-row{
    display:grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
    background: var(--line); border-radius: var(--radius-panel); overflow:hidden;
    border: 1px solid var(--line);
  }
  @media (max-width: 700px){ .stage-row{ grid-template-columns: 1fr; } }
  .stage{
    background: var(--panel); padding: 28px 26px;
  }
  .stage .idx{
    font-family: var(--font-head); font-weight:800; font-size:.82rem;
    color: var(--steel-deep); letter-spacing:.04em; margin-bottom: 12px; display:block;
  }
  .stage h3{ margin:0 0 8px; font-family: var(--font-head); font-size:1.12rem; font-weight:700; }
  .stage p{ margin:0; color: var(--ink-soft); font-size:.94rem; }

  /* ---------- gallery ---------- */
  .gallery-grid{
    display:grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
  }
  @media (max-width: 780px){ .gallery-grid{ grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px){ .gallery-grid{ grid-template-columns: 1fr; } }

  .gcard{
    border-radius: var(--radius-panel);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .gcard-art{
    aspect-ratio: 4 / 3;
    background: linear-gradient(155deg, var(--steel-deep), var(--steel));
    position: relative;
    overflow: hidden;
  }
  .gcard-art::before{
    content:"";
    position:absolute; inset:0;
    background: radial-gradient(circle at 82% 12%, color-mix(in srgb, #fff 16%, transparent), transparent 42%);
  }
  .gcard-art svg{ width:100%; height:100%; position:relative; z-index:1; }
  .gcard-body{ padding: 16px 18px 20px; }
  .gcard-body .gtag{
    font-size:.72rem; font-weight:700; color: var(--signal-deep);
    text-transform: none; margin-bottom:6px; display:block;
  }
  .gcard-body h3{ margin:0 0 4px; font-family: var(--font-head); font-size:1rem; font-weight:700; }
  .gcard-body p{ margin:0; color: var(--ink-soft); font-size:.88rem; }

  /* ---------- trust / technician ---------- */
  .trust{
    display:grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items:center;
  }
  @media (max-width: 780px){ .trust{ grid-template-columns:1fr; gap:32px; } }
  .tech-card{
    background: var(--panel); border:1px solid var(--line); border-radius: var(--radius-panel);
    padding: 28px; display:flex; flex-direction:column; gap:18px;
  }
  .tech-id{ display:flex; align-items:center; gap:16px; }
  .tech-avatar{
    width:64px; height:64px; border-radius:50%;
    background: linear-gradient(155deg, var(--steel-deep), var(--steel));
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-family: var(--font-head); font-weight:800; font-size:1.3rem;
    flex-shrink:0;
  }
  .tech-id h3{ margin:0 0 3px; font-family: var(--font-head); font-size:1.15rem; }
  .tech-id span{ color: var(--ink-soft); font-size:.9rem; }
  .badge-row{ display:flex; flex-wrap:wrap; gap:8px; }
  .badge{
    display:flex; align-items:center; gap:6px;
    font-size:.82rem; font-weight:600; color: var(--steel-deep);
    background: color-mix(in srgb, var(--steel) 12%, transparent);
    padding: 7px 12px; border-radius: var(--radius-dial);
  }
  .badge svg{ width:14px; height:14px; }

  .trust-copy h2{
    font-family: var(--font-head); font-weight:700; font-size: clamp(1.5rem, 2.8vw, 1.9rem);
    letter-spacing:-.01em; margin: 0 0 16px;
  }
  .trust-copy p{ color: var(--ink-soft); margin: 0 0 16px; font-size: 1.02rem; max-width: 52ch; }
  .check-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
  .check-list li{ display:flex; gap:10px; align-items:flex-start; font-size:.96rem; color: var(--ink); }
  .check-list svg{ width:18px; height:18px; flex-shrink:0; margin-top:2px; stroke: var(--ok); }

  /* ---------- brands marquee ---------- */
  .brand-marquee{
    position: relative;
    overflow: hidden;
    padding: 10px 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .brand-track{
    display: flex; align-items: center; gap: 56px;
    width: max-content;
    animation: marqueeScroll 22s linear infinite;
  }
  .brand-marquee:hover .brand-track{ animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce){ .brand-track{ animation: none; } }

  @keyframes marqueeScroll{
    from{ transform: translateX(0); }
    to{ transform: translateX(-50%); }
  }

  .brand-item{
    display:flex; align-items:center; gap: 14px;
    font-family: var(--font-head); font-weight:800; font-size:1.5rem;
    letter-spacing:-.02em; color: var(--ink-soft); white-space:nowrap;
    opacity: .8;
  }
  .brand-item .dot{ width:5px; height:5px; border-radius:50%; background: var(--signal); flex-shrink:0; }

  /* ---------- CTA band ---------- */
  .cta-band{
    background: linear-gradient(155deg, var(--ink), var(--steel-deep) 70%, var(--steel));
    border-radius: var(--radius-panel);
    padding: 44px 36px;
    color: #fff;
    display:grid; grid-template-columns: 1.2fr 0.8fr; gap: 24px; align-items:center;
  }
  @media (max-width: 700px){ .cta-band{ grid-template-columns:1fr; padding: 34px 24px; } }
  .cta-band h2{
    font-family: var(--font-head); font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight:700;
    margin:0 0 10px; letter-spacing:-.01em;
  }
  .cta-band p{ margin:0; opacity:.88; max-width: 42ch; }
  .cta-band .actions{ display:flex; flex-direction:column; gap:10px; }
  .cta-band .btn-primary{ background:#fff; color: var(--steel-deep); justify-content:center; }
  .cta-band .btn-primary:hover{ background: color-mix(in srgb, #fff 88%, var(--steel-deep)); }
  .cta-band .phone-big{
    font-family: var(--font-display); font-size: 1.5rem; font-weight:800; text-align:center;
    letter-spacing: -0.01em;
  }

  /* ---------- footer ---------- */
  footer{ border-top:1px solid var(--line); padding: 40px 0 110px; }
  .foot-grid{ display:flex; justify-content:space-between; gap:24px; flex-wrap:wrap; }
  .foot-brand{ font-family: var(--font-head); font-weight:700; }
  .foot-brand span{ display:block; color: var(--ink-soft); font-weight:400; font-size:.88rem; margin-top:4px; }
  .foot-links{ display:flex; gap: 26px; flex-wrap:wrap; font-size:.9rem; color: var(--ink-soft); }
  .foot-links a{ text-decoration:none; }
  .foot-links a:hover{ color: var(--steel-deep); }

  /* ---------- sticky mobile call bar ---------- */
  .sticky-call{
    position: fixed; left:16px; right:16px; bottom:16px; z-index: 60;
    display:none;
    background: var(--signal); color:#fff;
    border-radius: var(--radius-dial);
    padding: 15px 20px;
    align-items:center; justify-content:center; gap:9px;
    font-weight:700; text-decoration:none; font-size: .98rem;
    box-shadow: 0 12px 28px -8px rgba(0,0,0,.35);
  }
  .sticky-call svg{ width:17px; height:17px; }
  @media (max-width: 700px){ .sticky-call{ display:flex; } footer{ padding-bottom: 120px; } }

  :focus-visible{ outline: 2px solid var(--steel-deep); outline-offset: 3px; }

  /* ---------- animation: hero entrance ---------- */
  @keyframes fadeSlideUp{
    from{ opacity:0; transform: translateY(20px); }
    to{ opacity:1; transform: translateY(0); }
  }
  @keyframes fadeSlideLeft{
    from{ opacity:0; transform: translateX(24px); }
    to{ opacity:1; transform: translateX(0); }
  }
  @media (prefers-reduced-motion: no-preference){
    .eyebrow-row{ animation: fadeSlideUp .6s ease both .05s; }
    h1{ animation: fadeSlideUp .7s ease both .15s; }
    .hero p.lead{ animation: fadeSlideUp .7s ease both .3s; }
    .hero-ctas{ animation: fadeSlideUp .7s ease both .42s; }
    .hero-trust{ animation: fadeSlideUp .7s ease both .54s; }
    .panel-art{ animation: fadeSlideLeft .8s ease both .3s; }
  }

  /* ---------- animation: status LED pulse ---------- */
  @keyframes pulseLed{
    0%, 100%{ box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 22%, transparent); }
    50%{ box-shadow: 0 0 0 8px color-mix(in srgb, var(--ok) 10%, transparent); }
  }
  @media (prefers-reduced-motion: no-preference){
    .led{ animation: pulseLed 2.6s ease-in-out infinite; }
  }

  /* ---------- animation: hero dial needle sweep ---------- */
  @keyframes needleSweep{
    0%, 100%{ transform: rotate(0deg); }
    50%{ transform: rotate(22deg); }
  }
  @media (prefers-reduced-motion: no-preference){
    #hero-needle{ animation: needleSweep 5s ease-in-out infinite; transform-origin: 180px 140px; }
  }

  /* ---------- animation: scroll reveal ---------- */
  .reveal{
    opacity: 0; transform: translateY(22px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .reveal.is-visible{ opacity:1; transform: translateY(0); }

  .reveal-group > *{
    opacity: 0; transform: translateY(22px);
    transition: opacity .6s ease, transform .6s ease;
  }
  .reveal-group > *.is-visible{ opacity:1; transform: translateY(0); }
  .reveal-group > *:nth-child(1){ transition-delay: 0s; }
  .reveal-group > *:nth-child(2){ transition-delay: .08s; }
  .reveal-group > *:nth-child(3){ transition-delay: .16s; }
  .reveal-group > *:nth-child(4){ transition-delay: .24s; }
  .reveal-group > *:nth-child(5){ transition-delay: .32s; }
  .reveal-group > *:nth-child(6){ transition-delay: .4s; }

  @media (prefers-reduced-motion: reduce){
    .reveal, .reveal-group > *{ opacity:1; transform:none; transition:none; }
  }

  /* ---------- animation: card micro-interactions ---------- */
  .gcard-art svg{ transition: transform .4s ease; }
  .gcard:hover .gcard-art svg{ transform: scale(1.05); }

  @media (prefers-reduced-motion: reduce){ *{ transition: none !important; scroll-behavior:auto !important; animation: none !important; } }
</style>
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true"></div>
      Antonio González <span style="color:var(--ink-soft); font-weight:500;">· Línea blanca</span>
    </div>
    <a class="call-chip" href="tel:+524428465670">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      442 846 5670
    </a>
  </div>
</header>

<main>
  <div class="wrap">
    <section class="hero" style="border-top:none; padding-bottom:0;">
      <div>
        <div class="eyebrow-row">
          <span class="led" aria-hidden="true"></span>
          <span>Disponible hoy · Revisión sin costo</span>
        </div>
        <h1>Tu lavadora, secadora o A/C, <em>reparados por quien sí sabe de LG y Samsung.</em></h1>
        <p class="lead">Antonio González, técnico especializado en línea blanca premium. Diagnóstico sin costo, refacciones correctas y trabajo garantizado — en tu casa, sin sorpresas.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="tel:+524428465670">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Agenda al 442 846 5670
          </a>
          <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
        </div>
        <div class="hero-trust">
          <div class="item"><span class="num">0$</span><span class="lbl">Revisión a domicilio</span></div>
          <div class="item"><span class="num">LG · Samsung</span><span class="lbl">Especialidad premium</span></div>
          <div class="item"><span class="num">1</span><span class="lbl">Técnico, tu contacto directo</span></div>
        </div>
      </div>

      <div class="panel-art" role="img" aria-label="Ilustración de un panel de control de electrodoméstico">
        <svg viewBox="0 0 360 380" fill="none">
          <rect x="20" y="20" width="320" height="340" rx="26" stroke="rgba(255,255,255,.22)" stroke-width="1.5"/>
          <circle cx="180" cy="140" r="72" stroke="rgba(255,255,255,.85)" stroke-width="2.5"/>
          <circle cx="180" cy="140" r="72" stroke="rgba(255,255,255,.25)" stroke-width="14"/>
          <path d="M180 68 A72 72 0 0 1 244 178" stroke="#D6293B" stroke-width="6" stroke-linecap="round"/>
          <line id="hero-needle" x1="180" y1="140" x2="180" y2="88" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
          <circle cx="180" cy="140" r="6" fill="#fff"/>
          <circle cx="70" cy="248" r="20" stroke="rgba(255,255,255,.7)" stroke-width="2"/>
          <circle cx="70" cy="248" r="3" fill="#fff"/>
          <circle cx="130" cy="260" r="14" stroke="rgba(255,255,255,.5)" stroke-width="2"/>
          <circle cx="290" cy="240" r="22" stroke="rgba(255,255,255,.7)" stroke-width="2"/>
          <circle cx="290" cy="240" r="3" fill="#fff"/>
